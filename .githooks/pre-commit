#!/bin/sh
# Fast checks (a few seconds) on the side of the repo the commit touches. The slow ones, the
# tests, run before a push. Turn this on with `make hooks`.
HOOK=pre-commit
. "$(dirname "$0")/lib.sh"
cd "$ROOT" || exit 1

CHANGED="$(git diff --cached --name-only --diff-filter=ACMR)"
[ -z "$CHANGED" ] && exit 0

if touches_backend; then
  need_backend
  echo "backend"
  # from backend/, where the ruff settings are, as `make lint` does; evals/ uses the same settings
  run "ruff check" sh -c "cd backend && .venv/bin/ruff check --config pyproject.toml . ../evals"
  run "ruff format --check" sh -c "cd backend && .venv/bin/ruff format --check --config pyproject.toml . ../evals"
fi

if touches_frontend && have_frontend_deps; then
  echo "frontend"
  run "type check" sh -c "cd frontend && npm run --silent typecheck"
  run "eslint" sh -c "cd frontend && npm run --silent lint"
fi
