POSTGRES_USER=agent
POSTGRES_PASSWORD=agent
POSTGRES_DB=agent
DATABASE_URL=postgresql+psycopg://agent:agent@localhost:5432/agent

OPENAI_API_KEY=
AGENT_MODEL=gpt-6-luna
JUDGE_MODEL=gpt-6-luna
EMBEDDING_MODEL=text-embedding-3-small

# Memory search: how much a newer memory is favoured, and how fast that fades (days)
RECENCY_WEIGHT=0.0005
RECENCY_HALF_LIFE_DAYS=365

# What the agent recalls before each reply: search mode (keyword, vector, hybrid, hybrid_recency),
# how many current memories, and how many past ones when the question is about the past
MEMORY_SEARCH_MODE=vector
RECALL_LIMIT=5
RECALL_HISTORY_LIMIT=3

# Limits: model calls per owner message, characters per message, stored messages per chat
AGENT_MAX_STEPS=6
MAX_MESSAGE_CHARS=4000
MAX_SESSION_MESSAGES=100

# Who the agent talks to. The name is optional; the time zone (an IANA name such as
# Europe/Lisbon) decides what "today" is in the prompt
OWNER_NAME=
OWNER_TIMEZONE=UTC

# Owner login. OWNER_PASSWORD_HASH comes from `python -m app.auth hash` (keep the single quotes:
# the hash holds $ signs). JWT_SECRET signs the tokens: at least 32 random characters, e.g.
# `python -m app.auth secret`
OWNER_PASSWORD_HASH=
JWT_SECRET=
TOKEN_TTL_MINUTES=720

# Tracing to Langfuse Cloud. Leave the keys empty to turn tracing off
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=

# Host port for the database container; set it if 5432 is taken, and match it in DATABASE_URL
# DB_PORT=5432
