POSTGRES_USER=agent
POSTGRES_PASSWORD=agent
POSTGRES_DB=agent
DATABASE_URL=postgresql+psycopg://agent:agent@localhost:5432/agent

# `dev` serves the interactive API docs at /docs; leave it out anywhere the server is reachable
APP_ENV=dev

OPENAI_API_KEY=
AGENT_MODEL=gpt-6-luna
JUDGE_MODEL=gpt-6-luna
# Model for the memory-extraction step; empty uses AGENT_MODEL
EXTRACTION_MODEL=
# Stored memories less similar than this to a new statement are not compared with it (docs/PHASE5.md)
RECONCILE_MIN_SIMILARITY=0.35
# Set to false to keep recalling memories but stop writing new ones
MEMORY_WRITES_ENABLED=true
EMBEDDING_MODEL=text-embedding-3-small

# Memory search: how much a newer memory is favoured, and how fast that fades (days)
RECENCY_WEIGHT=0.0005
RECENCY_HALF_LIFE_DAYS=365

# What the agent recalls before each reply: search mode (keyword, vector, hybrid, hybrid_recency),
# how many current memories, and how many past ones when the question is about the past
MEMORY_SEARCH_MODE=vector
RECALL_LIMIT=5
RECALL_HISTORY_LIMIT=3

# Limits: model calls per owner message, characters per message, stored messages per chat
AGENT_MAX_STEPS=6
MAX_MESSAGE_CHARS=4000
MAX_SESSION_MESSAGES=100

# Who the agent talks to. The name is optional; the time zone (an IANA name such as
# Europe/Lisbon) decides what "today" is in the prompt
OWNER_NAME=
OWNER_TIMEZONE=UTC

# Owner login. OWNER_PASSWORD_HASH comes from `python -m app.auth hash` (keep the single quotes:
# the hash holds $ signs). JWT_SECRET signs the tokens: at least 32 random characters, e.g.
# `python -m app.auth secret`
OWNER_PASSWORD_HASH=
JWT_SECRET=
TOKEN_TTL_MINUTES=720

# The MCP servers the agent reads the mailbox and calendar through (docs/PHASE6.md). The secret signs
# the token every request carries, and the servers need the same one: at least 32 characters, e.g.
# `python -m app.auth secret` (use another value than JWT_SECRET). A URL left empty means that
# server is not used. Start the servers with `make mcp-email` and `make mcp-calendar`; MCP_PROVIDER
# is `fake` (a made-up mailbox and calendar) until a real provider is added
MCP_SIGNING_SECRET=
MCP_EMAIL_URL=
MCP_CALENDAR_URL=
MCP_PROVIDER=fake
# MCP_EMAIL_URL=http://127.0.0.1:8101/mcp
# MCP_CALENDAR_URL=http://127.0.0.1:8102/mcp

# Tracing to Langfuse Cloud. Leave the keys empty to turn tracing off
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=

# Host port for the database container; set it if 5432 is taken, and match it in DATABASE_URL
# DB_PORT=5432
